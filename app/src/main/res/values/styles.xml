<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Kartu putih membulat dengan garis tipis -->
    <style name="Widget.SkripsiTrack.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/st_border</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Tombol utama -->
    <style name="Widget.SkripsiTrack.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/st_deep</item>
    </style>

    <!-- Tombol garis merah (Keluar) -->
    <style name="Widget.SkripsiTrack.Button.Danger" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/st_rev_text</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeColor">@color/st_danger</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="iconTint">@color/st_rev_text</item>
        <item name="rippleColor">@color/st_rev_bg</item>
    </style>

    <!-- Kolom isian -->
    <style name="Widget.SkripsiTrack.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxBackgroundColor">@color/st_input_bg</item>
        <item name="boxStrokeColor">@color/text_input_stroke</item>
        <item name="hintTextColor">@color/st_deep</item>
    </style>

    <style name="Widget.SkripsiTrack.TextInput.Search">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/text_input_stroke_light</item>
        <item name="startIconDrawable">@drawable/ic_search</item>
        <item name="startIconTint">@color/st_muted</item>
    </style>

    <style name="Widget.SkripsiTrack.TextInput.Dropdown"
        parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxBackgroundColor">@color/st_input_bg</item>
        <item name="boxStrokeColor">@color/text_input_stroke</item>
        <item name="hintTextColor">@color/st_deep</item>
    </style>

    <!-- Chip filter: aktif = biru tua, tidak aktif = putih -->
    <style name="Widget.SkripsiTrack.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textSize">13sp</item>
        <item name="chipMinHeight">44dp</item>
        <item name="chipCornerRadius">22dp</item>
        <item name="checkedIconVisible">false</item>
    </style>

    <!-- Bar progres: tanpa titik di ujung, sudut membulat -->
    <style name="Widget.SkripsiTrack.LinearProgress" parent="Widget.Material3.LinearProgressIndicator">
        <item name="indicatorColor">@color/st_deep</item>
        <item name="trackColor">@color/st_track</item>
        <item name="trackThickness">8dp</item>
        <item name="trackCornerRadius">4dp</item>
        <item name="trackStopIndicatorSize">0dp</item>
    </style>

    <!-- Navigasi bawah -->
    <style name="Widget.SkripsiTrack.BottomNav" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@drawable/bg_bottom_nav</item>
        <item name="elevation">0dp</item>
        <item name="itemIconTint">@color/nav_item</item>
        <item name="itemTextColor">@color/nav_item</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.SkripsiTrack.NavLabel.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.SkripsiTrack.NavLabel</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="TextAppearance.SkripsiTrack.NavLabel" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">normal</item>
    </style>

    <style name="TextAppearance.SkripsiTrack.NavLabel.Active">
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Judul layar -->
    <style name="TextAppearance.SkripsiTrack.Title" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textColor">@color/st_ink</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
