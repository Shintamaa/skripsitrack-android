<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/st_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <FrameLayout
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:background="@drawable/bg_logo_tile"
        android:elevation="3dp">

        <ImageView
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:layout_gravity="center"
            android:contentDescription="Logo SkripsiTrack"
            android:src="@drawable/ic_logo_mark" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:alpha="0"
        android:gravity="center"
        android:text="Pantau Progres Skripsi Anda"
        android:textColor="@color/st_deep"
        android:textSize="23sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTagline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:alpha="0"
        android:gravity="center"
        android:lineSpacingMultiplier="1.15"
        android:text="Timeline tahapan, pengumpulan dokumen, dan riwayat bimbingan dalam satu aplikasi."
        android:textColor="@color/st_muted"
        android:textSize="14sp" />

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="190dp"
        android:layout_height="6dp"
        android:layout_marginTop="34dp"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="@color/st_deep"
        android:progressBackgroundTint="@color/st_track" />
</LinearLayout>
