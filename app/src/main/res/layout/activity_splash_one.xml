<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/st_deep">

    <View
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-105dp"
        android:layout_marginEnd="-95dp"
        android:alpha="0.14"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/st_sky" />

    <View
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="-65dp"
        android:layout_marginStart="-75dp"
        android:alpha="0.10"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/st_cream" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp">

        <FrameLayout
            android:layout_width="132dp"
            android:layout_height="132dp"
            android:background="@drawable/bg_logo_tile"
            android:elevation="8dp">

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="104dp"
                android:layout_height="104dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:contentDescription="Logo SkripsiTrack"
                android:src="@drawable/ic_logo_mark" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:alpha="0"
            android:fontFamily="sans-serif-medium"
            android:text="SkripsiTrack"
            android:textColor="@color/white"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Temani setiap langkah menuju sidang."
            android:textColor="@color/st_on_deep_muted"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
